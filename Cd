import re
s = set()
code = input("Enter a statement: ")
tokens = re.findall(r'//.*|[a-zA-Z_]\w*|\d+|[+\-*/=]', code)
for t in tokens:
   if t.startswith("//"):
       print(t, "- Comment")
   elif t in ["int", "float", "char", "if", "else"]:
       print(t, "- Keyword")
   elif t.isdigit():
       print(t, "- Constant")
   elif t in "+-*/=":
       print(t, "- Operator")
   else:
       print(t, "- Identifier")
       s.add(t)
print("\nSymbol Table:")
for x in sorted(s):
   print(x)
