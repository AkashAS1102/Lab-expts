import re
s = input("Enter a control structure: ")
if re.fullmatch(r'for\s*\(.*;.*;.*\)\s*', s):
   print("Valid For Loop")
elif re.fullmatch(r'while\s*\(.+\)', s):
   print("Valid While Loop")
elif re.fullmatch(r'if\s*\(.+\)\s*', s):
   print("Valid If Statement")
elif re.fullmatch(r'if\s*\(.+\)\s*else\s*', s):
   print("Valid If-Else Statement")
elif re.fullmatch(r'if\s*\(.+\)\s*else\s+if\s*\(.+\)', s):
   print("Valid If-Else-If Statement")
elif re.fullmatch(r'switch\s*\(.+\)', s):
   print("Valid Switch Statement")
else:
   print("Invalid Control Structure")
