# ==========================================
# EXPERIMENT 10: CONTROL STRUCTURE SYNTAX CHECKER
# ==========================================

import re

lines = []
while True:
    line = input()
    if line == "END":
        break
    lines.append(line)

text = "\n".join(lines)
stack = []
matching = {")": "(", "}": "{", "]": "["}
ok = True

for ch in text:
    if ch in "({[":
        stack.append(ch)
    elif ch in ")}]":
        if not stack or stack.pop() != matching[ch]:
            ok = False
            break

if stack or re.search(r"\belse\s*$", text):
    ok = False

for word in ("for", "while", "if", "switch"):
    for match in re.finditer(r"\b" + word + r"\b", text):
        if not re.match(r"\s*\(", text[match.end():]):
            ok = False

print("Valid syntax" if ok else "Syntax error")
